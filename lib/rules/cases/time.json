      "input": { "airports": [{ "code": "XXX", "utc_offset": null, "mct_min": null }] },
      "ask": { "what": "local", "airport": "XXX", "utc_week_min": 600 },
      "answer": { "offset_min": 0, "local_week_min": 600, "day": 1, "clock": "10:00" }
    },
    {
