      "rule": "manual §9; airports.utc_offset",
      "ask": { "what": "local", "airport": "CCC", "utc_week_min": 0 },
      "answer": { "offset_min": 330, "local_week_min": 330, "day": 1, "clock": "05:30" }
    },
    {
      "name": "west of UTC, Monday 00:00 UTC is still Sunday 19:00 local",
      "rule": "manual §9",
      "ask": { "what": "local", "airport": "BBB", "utc_week_min": 0 },
      "answer": { "offset_min": -300, "local_week_min": 9780, "day": 7, "clock": "19:00" }
    },
    {
      "name": "an airport with an override of its UTC offset uses the override (5 corrected to 5.5)",
